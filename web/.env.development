# 개발 모드(`npm run dev -w @aim/pleos`) 기본값. 커밋된다 — 시크릿을 넣지 말 것.
#
# 로컬 CMS(aimmovie_admin)를 가리킨다.
#   cd /Volumes/T7/studioAim/aimmovie_admin && npm start
# 8066은 이 프로젝트의 로컬 CMS 관례다.
VITE_API_ROOT=http://localhost:8066

# 미디어(HLS)는 로컬에 없으므로 개발 중에도 운영 CDN을 그대로 쓴다.
VITE_CDN_URL=https://cdn.aimmoviestream.com

# 팝콘 차감 대여. Pleos 결제·포인트 정책이 확정될 때까지(2027 예정) 끈다 — 유료 콘텐츠는 웹·모바일 대여 안내를 띄운다.
# 다시 켜려면 이 줄을 지우거나 true 로 바꾼다(README "대여 끄기" 참고).
VITE_RENT_ENABLED=false
